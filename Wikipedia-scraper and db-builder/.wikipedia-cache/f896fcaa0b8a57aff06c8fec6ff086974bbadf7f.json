tV_Osning_zu_Bielefeld.png/60px-Sign_-_KStV_Osning_zu_Bielefeld.png?utm_source=de.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"60\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/02/Sign_-_KStV_Osning_zu_Bielefeld.png/120px-Sign_-_KStV_Osning_zu_Bielefeld.png?utm_source=de.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"481\" data-file-height=\"481\" /></a></span>\n</td>\n<td><a href=\"/wiki/Kartellverband_katholischer_deutscher_Studentenvereine\" title=\"Kartellverband katholischer deutscher Studentenvereine\">KV</a>\n</td>\n<td><a href=\"/wiki/Nichtschlagend\" class=\"mw-redirect\" title=\"Nichtschlagend\">nichtschlagend</a>\n</td>\n<td>Männer\n</td>\n<td>\n</td></tr>\n<tr>\n<td data-sort-value=\"Sparrenberg\">AV Sparrenberg<sup id=\"cite&#95;ref-6\" class=\"reference\"><a href=\"#cite_note-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td>1985\n</td>\n<td class=\"hintergrundfarbe5\" style=\"text-align:center;\" data-sort-value=\"rot-weiß-blau\">\n<table class=\"centered\" style=\"width:60px; border: 1px solid; border-collapse: collapse;\">\n\n<tbody><tr>\n<td style=\"color:inherit; background:silver; height:1px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:white; height:1px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:red; height:7.3px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:white; height:7.3px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:blue; height:7.3px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:white; height:1px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:silver; height:1px\">\n</td></tr></tbody></table> rot-weiß-blau auf weiß\n</td>\n<td><span typeof=\"mw:File\"><a href=\"/wiki/Datei:Sparrenberg_Wappen.JPG\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e5/Sparrenberg_Wappen.JPG/60px-Sparrenberg_Wappen.JPG?utm_source=de.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"85\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e5/Sparrenberg_Wappen.JPG/120px-Sparrenberg_Wappen.JPG?utm_source=de.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"362\" data-file-height=\"513\" /></a></span>\n</td>\n<td><span typeof=\"mw:File\"><a href=\"/wiki/Datei:Sparrenberg_Zirkel.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/54/Sparrenberg_Zirkel.jpg/60px-Sparrenberg_Zirkel.jpg?utm_source=de.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"60\" height=\"89\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/54/Sparrenberg_Zirkel.jpg/120px-Sparrenberg_Zirkel.jpg?utm_source=de.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"418\" data-file-height=\"618\" /></a></span>\n</td>\n<td><a href=\"/wiki/Cartellverband_der_katholischen_deutschen_Studentenverbindungen\" title=\"Cartellverband der katholischen deutschen Studentenverbindungen\">CV</a>\n</td>\n<td>nichtschlagend\n</td>\n<td><a href=\"/wiki/M%C3%A4nnerbund\" title=\"Männerbund\">Männer</a>\n</td>\n<td>\n</td></tr>\n<tr>\n<td data-sort-value=\"VDSt\">VDSt Bielefeld<sup id=\"cite&#95;ref-7\" class=\"reference\"><a href=\"#cite_note-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td>1985\n</td>\n<td class=\"hintergrundfarbe5\" style=\"text-align:center;\" data-sort-value=\"schwarz-weiß-rot\">\n<table class=\"centered\" style=\"width:60px; border: 1px solid; border-collapse: collapse;\">\n\n<tbody><tr>\n<td style=\"color:inherit; background:silver; height:1px\">\n</