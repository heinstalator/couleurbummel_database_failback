/div>\n<p><small>Die Sortierung erfolgt nach dem Gründungsdatum.</small>\n</p>\n<table class=\"wikitable sortable\" style=\"width:100%;\">\n\n<tbody><tr>\n<th>Name\n</th>\n<th>Gründung\n</th>\n<th>Farben\n</th>\n<th class=\"unsortable\">Wappen\n</th>\n<th class=\"unsortable\">Zirkel\n</th>\n<th>Verband\n</th>\n<th>Fechtfrage\n</th>\n<th>Mitglieder\n</th>\n<th class=\"unsortable\">Anmerkungen\n</th></tr>\n<tr>\n<td>RAV Bavaria<sup id=\"cite&#95;ref-:1&#95;7-0\" class=\"reference\"><a href=\"#cite_note-:1-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td>1895\n</td>\n<td class=\"hintergrundfarbe5\" style=\"text-align:center;\" data-sort-value=\"schwarz-grün-gold\">\n<table class=\"centered\" style=\"width:60px; border: 1px solid; border-collapse: collapse;\">\n\n<tbody><tr>\n<td style=\"color:inherit; background:silver; height:1px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:white; height:9px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:lightblue; height:9px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:white; height:9px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:silver; height:1px\">\n</td></tr></tbody></table>\n<p>weiß-blau-weiß\n</p>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td><a href=\"/wiki/Nichtschlagend\" class=\"mw-redirect\" title=\"Nichtschlagend\">nichtschlagend</a>\n</td>\n<td><a href=\"/wiki/M%C3%A4nnerbund\" title=\"Männerbund\">Männer</a>\n</td>\n<td>Hellblaue Seidenmützen, 1933 mit RAV Absolvia Hof fusioniert\n</td></tr>\n<tr>\n<td>Abituria JPG<sup id=\"cite&#95;ref-:1&#95;7-1\" class=\"reference\"><a href=\"#cite_note-:1-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td>9. Juni 1907\n</td>\n<td class=\"hintergrundfarbe5\" style=\"text-align:center;\" data-sort-value=\"schwarz-grün-gold\">\n<table class=\"centered\" style=\"width:60px; border: 1px solid; border-collapse: collapse;\">\n\n<tbody><tr>\n<td style=\"color:inherit; background:silver; height:1px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:white; height:9px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:red; height:9px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:white; height:9px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:silver; height:1px\">\n</td></tr></tbody></table>\n<p>weiß-rot-weiß\n</p>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td><a href=\"/wiki/Nichtschlagend\" class=\"mw-redirect\" title=\"Nichtschlagend\">nichtschlagend</a>\n</td>\n<td><a href=\"/wiki/M%C3%A4nnerbund\" title=\"Männerbund\">Männer</a>\n</td>\n<td>Vorläufer ab 1823 nachweisbar; rote Mützen, Wahlspruch: <i>Per aspera ad astra!</i>, 1938 durch Ministerialerlass aufgelöst, 1953 reaktiviert, 1970 suspendiert, AHV 1995 aufgelöst\n</td></tr>\n<tr>\n<td>RSV Normannia<sup id=\"cite&#95;ref-:1&#95;7-2\" class=\"reference\"><a href=\"#cite_note-:1-7\"><span class=\"cite-bracket\">&#91;</span>7<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td>1921\n</td>\n<td class=\"hintergrundfarbe5\" style=\"text-align:center;\" data-sort-value=\"schwarz-grün-gold\">\n<table class=\"centered\" style=\"width:60px; border: 1px solid; border-collapse: collapse;\">\n\n<tbody><tr>\n<td style=\"color:inherit; background:silver; height:1px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:green; height:9px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:white; height:9px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:black; height:9px\">\n</td></tr>\n<tr>\n<td style=\"color:inherit; background:silver; height:1px\">\n</td></tr></tbody></table>\n<p>grün-weiß-schwarz\n</p>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td>\n</td>\n<td><a href=\"/wiki/Nichtschlagend\" class=\"mw-redirect\" title=\"Nichtschlagend\">nichtschlagend</a>\n</td>\n<td><a href=\"/wiki/M%C3%A4nnerbund\" title=\"Männerbund\">Männer</a>\n</td>\n<td>1933